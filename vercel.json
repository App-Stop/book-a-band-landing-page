{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "book-a-band-landing-page.vercel.app" }
      ],
      "destination": "https://bookabandapp.com/:path*",
      "permanent": true
    }
  ]
}
